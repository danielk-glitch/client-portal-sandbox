+.open-house-panel .timeline-item.portal-date-row:last-child { border-bottom: 0; }
+.open-house-panel .timeline-item .portal-date-row-main::after { inset: -12px -16px; border-radius: 16px; }
+
+/* ---------- Modal ---------- */
+
+.open-house-detail { display: grid; gap: 24px; }
+
+.open-house-group { display: grid; gap: 12px; }
+.open-house-group-title.MuiTypography-root {
+  margin: 0;
+  color: var(--color-semantic-text-light);
+  text-transform: uppercase;
+  letter-spacing: 0.12em;
+}
+
+.open-house-stats {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: 12px;
+  margin: 0;
+}
+.open-house-stat {
+  display: grid;
+  gap: 4px;
+  padding: 20px;
+  border: 1px solid var(--color-semantic-stroke-primary-light);
+  border-radius: 16px;
+}
+.open-house-stat dd { margin: 0; color: var(--color-semantic-text-dark); font-variant-numeric: tabular-nums; }
+
+.open-house-facts {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: 16px 24px;
+  margin: 0;
+  padding: 20px;
+  border-radius: 16px;
+  background: var(--color-semantic-surface-secondary);
+}
+.open-house-facts dt { color: var(--color-semantic-text-light); }
+.open-house-facts dd { margin: 4px 0 0; color: var(--color-semantic-text-dark); font-variant-numeric: tabular-nums; }
+.open-house-host.MuiTypography-root { display: inline-flex; align-items: center; gap: 6px; }
